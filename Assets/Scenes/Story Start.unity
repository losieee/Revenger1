  m_text: "\uADF8\uB294 \uB098\uC5D0\uAC8C \uCDA9\uACA9\uC801\uC778 \uC18C\uC2DD\uC744
    \uC804\uD588\uB2E4.\r\n\uB098\uB97C \uBAB0\uB77D\uC2DC\uD0A8 \uC790\uB4E4\uC774
    \uC774\uC81C\uB294 \uC601\uC6C5\uC774 \uB418\uC5B4 \uAD8C\uB825\uC744 \uC950\uACE0
    \uC788\uB2E4\uB294 \uC0AC\uC2E4\uC744. \n \u2018\uBCA0\uB974\uB108 \uC288\uD0C0\uC778\u2019\uACFC
